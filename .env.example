# 复制为 .env 后按需修改；不带 .env 也能跑（默认 cassette 离线回放）

# ---------- OCR ----------
# gateway = 调真实网关（需 SBA_OCR_PUBLIC_BASE，OCR 服务端要能下载到文件）
# cassette = 离线回放 data/ocr_cassettes（默认，CI/无网可用）
# stub = 返回空文本，用于验证「不调 OCR」分支
SBA_OCR_MODE=cassette
SBA_OCR_URL=https://gateway.pltplt.com/ai/process
SBA_OCR_TASK=orderChange
# 例：SBA_OCR_PUBLIC_BASE=https://your-bucket.example.com/bills
SBA_OCR_PUBLIC_BASE=
SBA_OCR_RETRIES=3

# ---------- PDF 策略 ----------
# ocr  = PDF 一律送 OCR 网关（题目要求「PDF 和图片通过 OCR API 识别」，默认值）
#        网关失败时自动回退 PDF 文本层，并在 trace 记「结果来自文本层，非 OCR」
#        只有连文本层都没有的扫描件才会进 errors.json
# auto = 有文本层就读文本，省 OCR 预算
# text = 只用文本层，从不调 OCR
SBA_PDF_STRATEGY=ocr
# 文本层字符数低于这个值就当扫描件（回退判定也用它）
SBA_PDF_TEXT_MIN_CHARS=120

# ---------- LLM（不配 Key 会自动降级为纯规则轨，并在输出里标 degraded） ----------
SBA_LLM_ENABLED=auto
SBA_LLM_BASE_URL=https://api.deepseek.com/v1
SBA_LLM_MODEL=deepseek-chat
SBA_LLM_API_KEY=
SBA_LLM_TEMPERATURE=0

# ---------- 业务 ----------
SBA_ACCOUNTING_ENTITY=Origin Agent
# mirror = Credit Note 记在对侧科目（默认）；same_side = 同侧红字
SBA_CREDIT_NOTE_POLICY=mirror
SBA_MATCH_T4_STRICT=true

# ---------- 置信度阈值（低于则转 PENDING_REVIEW） ----------
SBA_CONF_AMOUNT=0.90
SBA_CONF_CURRENCY=0.90
SBA_CONF_NAME=0.60

# ---------- 审计留存 ----------
# 把每份文档「抽取时实际使用的文本」落到 out/<run>/raw/，供复核 span 的上下文。
# 敏感场景可设 false（只保留字段级 span）。
SBA_KEEP_RAW_TEXT=true
